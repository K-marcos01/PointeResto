# Environnement applicatif (development | production)
APP_ENV=development

# Connexion PostgreSQL (utilisée en local Docker ou sur Railway)
DATABASE_URL=postgresql://pointeresto_user:pointeresto_pass@db:5432/pointeresto

# Cache Clé-Valeur Redis
REDIS_URL=redis://redis:6379

# Origine autorisée pour les requêtes CORS (URL GitHub Pages en production)
CORS_ORIGIN=http://localhost:8080