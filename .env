# Environnement applicatif (development | production)
APP_ENV=development

# Clé secrète HMAC-SHA256 pour la signature des jetons d'authentification (à changer en production)
APP_SECRET=changez-moi-avec-une-cle-aleatoire-de-64-caracteres

# Port d'écoute du serveur PHP
PORT=8000

# Connexion PostgreSQL (URL complète prioritaire, ou paramètres séparés ci-dessous)
DATABASE_URL=postgresql://pointeresto_user:pointeresto_pass@localhost:5432/pointeresto
PGHOST=localhost
PGPORT=5432
PGDATABASE=pointeresto
PGUSER=pointeresto_user
PGPASSWORD=pointeresto_pass

# Cache Clé-Valeur Redis (repli automatique sur cache fichier si indisponible)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500